{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://channelforge.local/schemas/source-enrollment.schema.json",
  "title": "ChannelForge durable source enrollment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Version",
    "EnrollmentId",
    "Status",
    "GuideMode",
    "M3U",
    "XMLTV",
    "AcceptedWorkflow",
    "RefreshPolicy",
    "CreatedAtUtc",
    "UpdatedAtUtc",
    "EnrollmentHash"
  ],
  "properties": {
    "Version": { "const": "source-enrollment/v1" },
    "EnrollmentId": { "$ref": "#/$defs/hash" },
    "Status": { "const": "Valid" },
    "GuideMode": { "enum": ["NoGuide", "XMLTV"] },
    "M3U": { "$ref": "#/$defs/source" },
    "XMLTV": { "anyOf": [{ "$ref": "#/$defs/source" }, { "type": "null" }] },
    "AcceptedWorkflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["GenerationManifestHash", "AcceptedStateHash", "AcceptedOutputManifestHash"],
      "properties": {
        "GenerationManifestHash": { "type": ["string", "null"] },
        "AcceptedStateHash": { "type": ["string", "null"] },
        "AcceptedOutputManifestHash": { "type": ["string", "null"] }
      }
    },
    "LastRefreshStatus": { "enum": ["saved", "up-to-date", "changes-found"] },
    "RefreshPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Mode", "AutoAccept"],
      "properties": {
        "Mode": { "const": "Manual" },
        "AutoAccept": { "const": false }
      }
    },
    "CreatedAtUtc": { "type": "string", "format": "date-time" },
    "UpdatedAtUtc": { "type": "string", "format": "date-time" },
    "EnrollmentHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["SourceId", "Kind", "Format", "ManagedPath", "ContentHash", "ByteLength"],
      "properties": {
        "SourceId": { "$ref": "#/$defs/hash" },
        "Kind": { "enum": ["M3U", "XMLTV"] },
        "Format": { "enum": ["m3u", "xmltv"] },
        "ManagedPath": { "type": "string", "pattern": "^state/managed-sources/[0-9a-f]{64}\\.(m3u|xml)$" },
        "ContentHash": { "$ref": "#/$defs/hash" },
        "ByteLength": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
