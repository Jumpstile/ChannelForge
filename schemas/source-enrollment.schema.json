{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://channelforge.local/schemas/source-enrollment.schema.json",
  "title": "ChannelForge durable source-set v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Version",
    "SourceSetId",
    "EnrollmentId",
    "Status",
    "GuideMode",
    "Playlists",
    "Guides",
    "Bindings",
    "AcceptedWorkflow",
    "RefreshPolicy",
    "LastRefreshStatus",
    "CreatedAtUtc",
    "UpdatedAtUtc",
    "EnrollmentHash"
  ],
  "properties": {
    "Version": { "const": "source-enrollment/v2" },
    "SourceSetId": { "$ref": "#/$defs/hash" },
    "EnrollmentId": { "$ref": "#/$defs/hash" },
    "Status": { "const": "Valid" },
    "GuideMode": { "enum": ["NoGuide", "XMLTV"] },
    "Playlists": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "Guides": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "Bindings": { "type": "array", "items": { "$ref": "#/$defs/binding" } },
    "AcceptedWorkflow": { "$ref": "#/$defs/acceptedWorkflow" },
    "RefreshPolicy": { "$ref": "#/$defs/refreshPolicy" },
    "LastRefreshStatus": { "enum": ["saved", "up-to-date", "changes-found"] },
    "CreatedAtUtc": { "type": "string", "format": "date-time" },
    "UpdatedAtUtc": { "type": "string", "format": "date-time" },
    "EnrollmentHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "acceptedWorkflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "GenerationManifestHash",
        "AcceptedStateHash",
        "AcceptedOutputManifestHash"
      ],
      "properties": {
        "GenerationManifestHash": { "type": ["string", "null"] },
        "AcceptedStateHash": { "type": ["string", "null"] },
        "AcceptedOutputManifestHash": { "type": ["string", "null"] }
      }
    },
    "refreshPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Mode", "AutoAccept"],
      "properties": {
        "Mode": { "const": "Manual" },
        "AutoAccept": { "const": false }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "SourceId",
        "Kind",
        "Format",
        "Label",
        "SourceKind",
        "Enabled",
        "Present",
        "Priority",
        "OrderKey",
        "ManagedPath",
        "Url",
        "ContentHash",
        "ByteLength",
        "Provenance",
        "Refresh"
      ],
      "properties": {
        "SourceId": { "$ref": "#/$defs/hash" },
        "Kind": { "enum": ["M3U", "XMLTV"] },
        "Format": { "enum": ["m3u", "xmltv"] },
        "Label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "SourceKind": { "enum": ["managed-file", "public-https"] },
        "Enabled": { "type": "boolean" },
        "Present": { "type": "boolean" },
        "Priority": { "type": "integer" },
        "OrderKey": { "type": "string", "minLength": 1 },
        "ManagedPath": { "type": ["string", "null"] },
        "Url": { "type": ["string", "null"] },
        "ContentHash": {
          "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }]
        },
        "ByteLength": { "type": ["integer", "null"], "minimum": 0 },
        "Provenance": { "type": "object" },
        "Refresh": { "type": "object", "additionalProperties": true }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "BindingId",
        "GuideId",
        "PlaylistIds",
        "AppliesToAll",
        "Enabled",
        "Revision"
      ],
      "properties": {
        "BindingId": { "$ref": "#/$defs/hash" },
        "GuideId": { "$ref": "#/$defs/hash" },
        "PlaylistIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/hash" },
          "uniqueItems": true
        },
        "AppliesToAll": { "type": "boolean" },
        "ExplicitlyUnbound": { "const": true },
        "Enabled": { "type": "boolean" },
        "Revision": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
