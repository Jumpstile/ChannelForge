{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://channelforge.invalid/schemas/knowledge_change_plan.schema.json",
  "title": "ChannelForge Identity and Matching knowledge change plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Version",
    "PlanId",
    "BaseRevision",
    "BaseStateHash",
    "CreatedAtUtc",
    "Actions",
    "ConfirmationRequired",
    "PlanHash"
  ],
  "properties": {
    "Version": { "const": "knowledge-change-plan/v1" },
    "PlanId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "BaseRevision": { "type": "integer", "minimum": 0 },
    "BaseStateHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "CreatedAtUtc": { "type": "string", "format": "date-time" },
    "Actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["Action", "Reason"],
        "properties": {
          "Action": {
            "enum": [
              "RegisterIdentity",
              "AddBinding",
              "ProposeAlias",
              "AppendAliasEvidence",
              "Approve",
              "Reject",
              "Revoke",
              "MarkProbationary"
            ]
          },
          "Entry": { "type": "object" },
          "EntryId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "ObservationIds": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "minItems": 1,
            "uniqueItems": true
          },
          "EvidenceRecords": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ObservationIds",
                "Sides",
                "ConfidenceScore",
                "CorrelationBasis"
              ],
              "properties": {
                "ObservationIds": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  "uniqueItems": true
                },
                "Sides": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": { "type": "object" }
                },
                "ConfidenceScore": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "CorrelationBasis": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 },
                  "uniqueItems": true
                }
              }
            }
          },
          "Reason": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "Action": {
                  "enum": ["RegisterIdentity", "AddBinding", "ProposeAlias"]
                }
              },
              "required": ["Action"]
            },
            "then": { "required": ["Entry"] }
          },
          {
            "if": {
              "properties": {
                "Action": {
                  "enum": [
                    "AppendAliasEvidence",
                    "Approve",
                    "Reject",
                    "Revoke",
                    "MarkProbationary"
                  ]
                }
              },
              "required": ["Action"]
            },
            "then": { "required": ["EntryId"] }
          },
          {
            "if": {
              "properties": { "Action": { "const": "AppendAliasEvidence" } },
              "required": ["Action"]
            },
            "then": { "required": ["ObservationIds", "EvidenceRecords"] }
          }
        ]
      }
    },
    "ConfirmationRequired": { "const": true },
    "PlanHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
