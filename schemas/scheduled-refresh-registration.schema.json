{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://channelforge.invalid/schemas/scheduled-refresh-registration.schema.json",
  "title": "ChannelForge scheduled refresh registration evidence",
  "description": "Redacted evidence for one owned Windows Task Scheduler registration. It contains digests and bounded contract fields, never local paths or provider data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "SchemaVersion",
    "Owner",
    "TaskPath",
    "TaskName",
    "RootDigest",
    "PolicyDigest",
    "TaskDefinitionDigest",
    "RegisteredAtUtc",
    "TriggerKind",
    "CadenceMode",
    "CadenceAtUtc",
    "StartBoundaryUtc",
    "ExecutionTimeLimitMinutes",
    "RuntimeVersion",
    "RuntimeContract",
    "WrapperContract",
    "ReadyForFirstRun"
  ],
  "properties": {
    "SchemaVersion": { "const": "scheduled-refresh-registration/v1" },
    "Owner": { "const": "ChannelForge" },
    "TaskPath": { "const": "\\ChannelForge\\" },
    "TaskName": {
      "type": "string",
      "pattern": "^ScheduledRefresh-[0-9a-f]{16}$"
    },
    "RootDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "PolicyDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "TaskDefinitionDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "RegisteredAtUtc": { "type": "string", "format": "date-time" },
    "TriggerKind": { "const": "Scheduled" },
    "CadenceMode": { "const": "Daily" },
    "CadenceAtUtc": {
      "type": "string",
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "StartBoundaryUtc": { "type": "string", "format": "date-time" },
    "ExecutionTimeLimitMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 121
    },
    "RuntimeVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
    },
    "RuntimeContract": { "const": "PowerShell Core 7.6 or newer" },
    "WrapperContract": { "const": "scheduled-refresh-wrapper/v1" },
    "ReadyForFirstRun": { "const": true }
  }
}
