{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Jumpstile/ChannelForge/schemas/aed-defaults.schema.json",
  "title": "IPTV Boss AED Defaults Export",
  "description": "Shape contract for the file made by IPTV Boss > Settings > AED Defaults > Export Defaults (see Read-ChannelForgeAedDefaults.ps1). Unknown top-level fields are rejected. Unknown fields inside defaults pass this schema; the reader warns about them and drops them. Every default is optional.",
  "type": "object",
  "required": ["type", "version", "defaults"],
  "additionalProperties": false,
  "properties": {
    "type": { "const": "aed_defaults" },
    "version": { "const": 1 },
    "defaults": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "title_regex": { "type": "string" },
        "time_regex": { "type": "string" },
        "time_format": { "type": "string" },
        "source_time_zone": { "type": "string" },
        "date_regex": { "type": "string" },
        "date_format": { "type": "string" },
        "logo": { "type": "string" },
        "logo_url": { "type": "string" },
        "channel_name_regex": { "type": "string" },
        "channel_name_priority": { "type": "string" },
        "team_delimiter": { "type": "string" },
        "category": { "type": "string" },
        "output_time_format": { "type": "string" },
        "regex_based_next_event_title_format": { "type": "string" },
        "sports_based_next_event_title_format": { "type": "string" },
        "regex_based_next_event_description_format": { "type": "string" },
        "sports_based_next_event_description_format": { "type": "string" },
        "regex_based_title_output_format": { "type": "string" },
        "sports_based_title_output_format": { "type": "string" },
        "regex_based_description_output_format": { "type": "string" },
        "sports_based_description_output_format": { "type": "string" },
        "no_event_format": { "type": "string" },
        "after_event_format": { "type": "string" },
        "output_time_zone": { "type": "string" },
        "event_duration": { "type": "string" },
        "other_entry_duration": { "type": "string" },
        "include_ended_hours": { "type": "integer", "minimum": 0 },
        "include_within_hours": { "type": "integer", "minimum": 0 },
        "signing_off_length_hours": { "type": "integer", "minimum": 0 },
        "signing_off_cutoff_hour": { "type": "integer", "minimum": 0 },
        "event_match_window_minutes": { "type": "integer", "minimum": 0 },
        "simple_regex_dummy": { "type": "boolean" },
        "use_american_logo": { "type": "boolean" },
        "clean_regex_output": { "type": "boolean" },
        "allow_fuzzy_match": { "type": "boolean" },
        "match_by_display_name": { "type": "boolean" },
        "match_by_name": { "type": "boolean" },
        "match_by_location": { "type": "boolean" },
        "match_by_abbreviation": { "type": "boolean" }
      }
    }
  }
}
