{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://channelforge.invalid/schemas/guide-pattern-review.schema.json",
  "title": "ChannelForge event-pattern review report",
  "description": "Deterministic, redacted, candidate-only Stage C event-pattern review output.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ContractVersion",
    "ReportType",
    "Summary",
    "Pattern",
    "Fields",
    "Event",
    "Confidence",
    "Review",
    "Drift",
    "Provenance",
    "VolatileFacts",
    "Safety",
    "NextAction",
    "ExampleCount",
    "MatchedExampleCount",
    "ReadOnly",
    "RedactedFields"
  ],
  "properties": {
    "ContractVersion": { "const": "guide-intelligence/pattern-review/v1" },
    "ReportType": { "const": "BeginnerEventPatternReview" },
    "Summary": { "type": "object" },
    "Pattern": { "type": "object" },
    "Fields": { "type": "array", "items": { "type": "object" } },
    "Event": { "type": "object" },
    "Confidence": { "type": "object" },
    "Review": { "type": "object" },
    "Drift": { "type": "object" },
    "Provenance": { "type": "object" },
    "VolatileFacts": { "$ref": "#/$defs/volatileFacts" },
    "Safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "PublicationState",
        "CanPublish",
        "PromotionRequired",
        "AcceptedStateMutation",
        "AcceptedStatePreserved",
        "ReadOnly",
        "ProviderMutation",
        "DownstreamMutation",
        "FilesystemMutation"
      ],
      "properties": {
        "PublicationState": { "const": "CandidateOnly" },
        "CanPublish": { "const": false },
        "PromotionRequired": { "const": "ExplicitAcceptance" },
        "AcceptedStateMutation": { "const": "None" },
        "AcceptedStatePreserved": { "type": "boolean" },
        "ReadOnly": { "const": true },
        "ProviderMutation": { "const": false },
        "DownstreamMutation": { "const": false },
        "FilesystemMutation": { "const": false },
        "GuidePublication": { "const": false }
      }
    },
    "NextAction": { "type": "object" },
    "ExampleCount": { "type": "integer", "minimum": 0 },
    "MatchedExampleCount": { "type": "integer", "minimum": 0 },
    "ReadOnly": { "const": true },
    "RedactedFields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "volatileFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "FactId",
        "FactType",
        "SubjectType",
        "SubjectId",
        "SourceId",
        "SourceType",
        "SourceRelationship",
        "FetchedAtUtc",
        "DataTimestampUtc",
        "EvaluationInstantUtc",
        "EventStartUtc",
        "EventTimezone",
        "ValidFromUtc",
        "ValidToUtc",
        "Season",
        "SeasonPhase",
        "EventSeasonPhase",
        "Week",
        "Round",
        "Competition",
        "League",
        "Sport",
        "FreshnessState",
        "FreshnessTtlMinutes",
        "ConfidenceState",
        "Status",
        "ContradictionGroup",
        "Decision",
        "ReasonCodes"
      ],
      "properties": {
        "FactId": { "type": "string" },
        "FactType": { "type": "string" },
        "SubjectType": { "type": "string" },
        "SubjectId": { "type": "string" },
        "SourceId": { "type": "string" },
        "SourceType": { "type": "string" },
        "SourceRelationship": {
          "enum": ["Authoritative", "Independent", "Mirror", "Unknown"]
        },
        "FetchedAtUtc": { "type": "string" },
        "DataTimestampUtc": { "type": "string" },
        "EvaluationInstantUtc": { "type": "string" },
        "EventStartUtc": { "type": "string" },
        "EventTimezone": { "type": "string" },
        "ValidFromUtc": { "type": "string" },
        "ValidToUtc": { "type": "string" },
        "Season": { "type": "string" },
        "SeasonPhase": { "type": "string" },
        "EventSeasonPhase": { "type": "string" },
        "Week": { "type": "string" },
        "Round": { "type": "string" },
        "Competition": { "type": "string" },
        "League": { "type": "string" },
        "Sport": { "type": "string" },
        "FreshnessState": {
          "enum": ["Current", "Stale", "Unavailable", "Unknown"]
        },
        "FreshnessTtlMinutes": { "type": "integer", "minimum": 0 },
        "ConfidenceState": { "type": "string" },
        "Status": {
          "enum": [
            "Current",
            "Stale",
            "Unavailable",
            "Contradictory",
            "Unknown"
          ]
        },
        "ContradictionGroup": { "type": "string" },
        "Decision": {
          "enum": ["EligibleCurrent", "Omitted", "ReviewRequired"]
        },
        "ReasonCodes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "volatileFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Status",
        "Explanation",
        "Total",
        "EligibleCount",
        "OmittedCount",
        "Facts",
        "Omitted"
      ],
      "properties": {
        "Status": {
          "enum": [
            "NotProvided",
            "Eligible",
            "Contradictory",
            "SourceUnavailable",
            "StaleOrReviewNeeded",
            "ReviewNeeded"
          ]
        },
        "Explanation": { "type": "string" },
        "Total": { "type": "integer", "minimum": 0 },
        "EligibleCount": { "type": "integer", "minimum": 0 },
        "OmittedCount": { "type": "integer", "minimum": 0 },
        "Facts": {
          "type": "array",
          "items": { "$ref": "#/$defs/volatileFact" }
        },
        "Omitted": {
          "type": "array",
          "items": { "$ref": "#/$defs/volatileFact" }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["Status"],
            "properties": { "Status": { "const": "Eligible" } }
          },
          "then": {
            "properties": {
              "Facts": {
                "items": {
                  "properties": { "Decision": { "const": "EligibleCurrent" } }
                }
              },
              "Omitted": { "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "required": ["Status"],
            "properties": {
              "Status": {
                "enum": [
                  "NotProvided",
                  "Contradictory",
                  "SourceUnavailable",
                  "StaleOrReviewNeeded",
                  "ReviewNeeded"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "Facts": {
                "items": {
                  "properties": {
                    "Decision": { "enum": ["Omitted", "ReviewRequired"] }
                  }
                }
              },
              "Omitted": {
                "items": {
                  "properties": {
                    "Decision": { "enum": ["Omitted", "ReviewRequired"] }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
