{
  "name": "channelforge-gui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "npm run check:one-guide-validator && vite",
    "build": "npm run check:one-guide-validator && tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "npm run check:one-guide-validator && tsc -b --pretty false",
    "test": "npm run check:one-guide-validator && vitest run",
    "test:watch": "npm run check:one-guide-validator && vitest",
    "test:e2e": "npm run check:one-guide-validator && playwright test",
    "test:visual": "npm run check:one-guide-validator && playwright test --project=visual",
    "generate:one-guide-validator": "node scripts/generate-one-guide-validator.mjs",
    "check:one-guide-validator": "node scripts/generate-one-guide-validator.mjs --check"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.52.0",
    "@tauri-apps/cli": "2.8.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "jsdom": "^26.0.0",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^3.1.1"
  }
}
